{
  "name": "cubyntra",
  "version": "2.0.0",
  "description": "Cubyntra — Computer Vision Rubik's Cube Scanner & Solver by Necookie Labs",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-cert.mjs && next dev -H 0.0.0.0 --experimental-https --experimental-https-key .certs/dev-key.pem --experimental-https-cert .certs/dev-cert.pem",
    "dev:http": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tutor-soak": "vitest run --config vitest.soak.config.mts",
    "docs:pdf": "tsx scripts/generate-docs.ts",
    "coach:eval": "tsx scripts/coach-eval.ts",
    "voice:prewarm": "tsx scripts/voice-prewarm.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "jose": "^6.2.18",
    "lucide-react": "^1.48.0",
    "next": "16.4.6",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rubik-solver": "^0.1.2",
    "three": "^0.186.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "axe-core": "^4.14.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
