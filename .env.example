# Cubyntra Environment Configuration
# Copy to .env.local. Camera frames and photos never leave the device; no key is required.
NEXT_PUBLIC_APP_NAME="Cubyntra"
NEXT_PUBLIC_APP_TAGLINE="See it. Solve it."
NEXT_PUBLIC_APP_ORGANIZATION="Necookie Labs"

# AI coach (optional). Server-side only: never prefix with NEXT_PUBLIC_.
# Leave empty to run the coach in mock mode (built-in hint templates, no API calls).
ANTHROPIC_API_KEY=

# Hard monthly spend cap for the coach in US dollars (UTC calendar month). When reached, the
# coach switches to the built-in templates until the next month. Usage: data/coach-usage.json
COACH_MONTHLY_CAP_USD=10

# Voice (optional, ADR-016). Server-side only: never prefix with NEXT_PUBLIC_.
# Without a key the tutor can still speak with the browser's own voice (Settings -> Voice).
# Only the text to speak is sent to ElevenLabs (Flash v2.5, 0.5 credit per character).
ELEVENLABS_API_KEY=
# Optional: a stock (premade) voice id. Default: JBFqnCBsd6RMkjVDRZzb. No cloned voices.
ELEVENLABS_VOICE_ID=
# Monthly credit cap (UTC calendar month); the lower of this and the account's real balance is
# the limit. At the limit the device voice speaks. Usage: data/voice-usage.json
ELEVENLABS_MONTHLY_CREDIT_CAP=20000
