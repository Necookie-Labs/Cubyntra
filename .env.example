# Cubyntra Environment Configuration
# Copy to .env.local. Camera frames and photos never leave the device; no key is required.
NEXT_PUBLIC_APP_NAME="Cubyntra"
NEXT_PUBLIC_APP_TAGLINE="See it. Solve it."
NEXT_PUBLIC_APP_ORGANIZATION="Necookie Labs"

# AI coach (optional). Server-side only: never prefix with NEXT_PUBLIC_.
# Leave empty to run the coach in mock mode (built-in hint templates, no API calls).
ANTHROPIC_API_KEY=

# Hard monthly spend cap for the coach in US dollars (UTC calendar month). When reached, the
# coach switches to the built-in templates until the next month. Usage: data/coach-usage.json
COACH_MONTHLY_CAP_USD=10

# Voice (optional, ADR-016). Server-side only: never prefix with NEXT_PUBLIC_.
# Without a key the tutor can still speak with the browser's own voice (Settings -> Voice).
# Only the text to speak is sent to ElevenLabs (Flash v2.5, 0.5 credit per character).
ELEVENLABS_API_KEY=
# Optional: a stock (premade) voice id. Default: JBFqnCBsd6RMkjVDRZzb. No cloned voices.
ELEVENLABS_VOICE_ID=
# Monthly credit cap (UTC calendar month); the lower of this and the account's real balance is
# the limit. At the limit the device voice speaks. Usage: data/voice-usage.json
ELEVENLABS_MONTHLY_CREDIT_CAP=20000

# --- Hosting (optional, ADR-017; deploy/README.md) ---------------------------------------------
# How requests are authenticated. Leave unset on the laptop.
#   local              (default) laptop install: loopback-only app token, one data/student.json
#   cloudflare-access  behind Cloudflare Tunnel + Access: every API request must carry a valid
#                      Cf-Access-Jwt-Assertion JWT; loopback is never trusted
#   passcode           hosted without Access: /signin with a name and CUBYNTRA_ACCESS_CODE
# Any other value makes every API route refuse. Hosted modes keep one profile per person in
# data/students/<slug>.json; the coach and voice caps above stay global and shared.
CUBYNTRA_AUTH_MODE=
# cloudflare-access: the Zero Trust team domain (JWKS at https://<it>/cdn-cgi/access/certs)
# and the Access application's Audience (AUD) tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# cloudflare-access (optional): a second allowlist inside the app, comma-separated emails.
CUBYNTRA_ALLOWED_EMAILS=
# passcode: the shared access code, at least 8 characters. Shorter or empty refuses every sign-in.
CUBYNTRA_ACCESS_CODE=
# Hosted: the public origin used in the phone pairing QR link instead of the server's LAN address.
PUBLIC_ORIGIN=
# Optional: where profiles, usage files and the app secret live (default: ./data).
CUBYNTRA_DATA_DIR=
